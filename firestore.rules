rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User documents - own user only
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Deck documents - public read, auth write
    match /decks/{deckId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Card documents - public read, auth write
    match /decks/{deckId}/cards/{cardId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Progress documents - only owner can read/write
    match /decks/{deckId}/cards/{cardId}/progress/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}